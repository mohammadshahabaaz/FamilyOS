DATABASE_URL=postgresql://familyos:familyos@localhost:5442/familyos
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Local dev default: talks to the minio service in docker-compose.yml.
# For production, point these at a real Cloudflare R2 bucket instead:
#   R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID=your-r2-access-key
#   R2_SECRET_ACCESS_KEY=your-r2-secret-key
#   R2_PUBLIC_URL=https://media.yourdomain.com
R2_ENDPOINT=http://localhost:9010
R2_ACCESS_KEY_ID=familyos
R2_SECRET_ACCESS_KEY=familyos123
R2_BUCKET=familyos-media
R2_PUBLIC_URL=http://localhost:9010/familyos-media
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
STORAGE_LIMIT_BYTES=5368709120
